    {
      "parameters": {
        "jsCode": "const salida = $input.first().json.output || '';\nconst to = $('Armar contexto').first().json.from;\nlet valido = false;\nlet accion = 'DERIVAR';\nlet respuesta = 'Hola, tu consulta la va a revisar una persona de RRHH y se comunicará en horario de atención. Saludos.';\ntry {\n  const limpio = salida.replace(/<think>[\\s\\S]*?<\\/think>/g, '').replace(/```json|```/g, '').trim();\n  const j = JSON.parse(limpio);\n  if ((j.accion === 'RESPONDER' || j.accion === 'DERIVAR') && typeof j.respuesta === 'string' && j.respuesta.trim() !== '') {\n    accion = j.accion;\n    respuesta = j.respuesta.trim();\n    valido = true;\n  }\n} catch (e) {}\nreturn [{ json: { valido, accion, respuesta, to } }];"
      },
      "type": "n8n-nodes-base.code",
